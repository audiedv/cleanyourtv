<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF101419" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="72dp" android:paddingEnd="72dp"
        android:paddingTop="36dp" android:paddingBottom="52dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/launcher_settings" android:textColor="#FFFFFFFF" android:textSize="34sp" />
        <TextView style="@style/SettingsIntro" android:text="@string/settings_intro" />

        <TextView style="@style/SettingsSection" android:text="@string/settings_header_section" />
        <TextView android:id="@+id/nameChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/dateChoice" style="@style/SettingsRow" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/weatherChoice" style="@style/SettingsRow" android:layout_marginTop="8dp" />

        <TextView style="@style/SettingsSection" android:text="@string/settings_dock_section" />
        <TextView android:id="@+id/reorderChoice" style="@style/SettingsRow"
            android:text="@string/reorder" android:visibility="gone" />
        <TextView android:id="@+id/dockSizeChoice" style="@style/SettingsRow" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsFieldLabel" android:text="@string/columns_label" />
        <LinearLayout style="@style/SettingsOptionRow">
            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>
        <TextView style="@style/SettingsFieldLabel" android:text="@string/rows_below_dock_label" />
        <LinearLayout style="@style/SettingsOptionRow">
            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>
        <TextView style="@style/SettingsFieldLabel" android:text="@string/dock_opacity_label" />
        <LinearLayout style="@style/SettingsOptionRow">
            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <TextView style="@style/SettingsSection" android:text="@string/settings_wallpaper_section" />
        <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/wallpaperTimerChoice" style="@style/SettingsRow" android:layout_marginTop="8dp" />

        <TextView style="@style/SettingsSection" android:text="@string/settings_motion_section" />
        <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="8dp" />
        <TextView style="@style/SettingsHint" android:text="@string/advanced_effects_warning" />

        <TextView style="@style/SettingsSection" android:text="@string/settings_system_section" />
        <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:text="@string/follow_theme" />
        <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />
        <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow"
            android:layout_marginTop="14dp" android:text="@string/home_settings" />
        <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow"
            android:layout_marginTop="8dp" android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
